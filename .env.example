# Credenciales Ubidots Industrial
UBIDOTS_TOKEN=your-ubidots-token-here
UBIDOTS_DEVICE=nombre-del-device

# Broker MQTT de Ubidots Industrial.
MQTT_BROKER=industrial.api.ubidots.com
# MQTT_TLS=true -> mqtts:// (8883, recomendado). false -> mqtt:// plano (1883).
# Si omites MQTT_PORT, se elige solo segun MQTT_TLS (8883 con TLS, 1883 sin).
MQTT_TLS=true
MQTT_PORT=8883

# Servidor web
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Nivel de logging (debug | info | warn | error)
LOG_LEVEL=info

# Modo desarrollo: inyecta datos simulados sin conexion a Ubidots
MOCK_DATA=false

# ===== Agente IA conversacional (Ollama Cloud) =====
# Si AGENT_ENABLED=true y hay OLLAMA_API_KEY, se expone POST /api/agent/chat y
# aparece el widget de chat en el dashboard. Sin API key el agente queda
# inactivo (el chat responde 503), pero el resto del dashboard funciona igual.
AGENT_ENABLED=true

# Endpoint de Ollama Cloud (dejar por default salvo que uses Ollama local)
OLLAMA_HOST=https://ollama.com

# Modelo a usar. gpt-oss:120b es capaz pero algo lento; modelos mas chicos
# (ej. granite4.1:8b) son mas rapidos y baratos.
OLLAMA_MODEL=gpt-oss:120b

# API key de Ollama Cloud. Obtener en https://ollama.com/settings/keys
OLLAMA_API_KEY=

# ===== Alertas (log de transiciones ok<->abnormal) =====
# SQLite local donde se registran las transiciones de estado para que el agente
# pueda responder "¿hubo anomalias hoy?" tras reinicios.
ALERT_DB_PATH=logs/alerts.db
# Detector de saltos bruscos: delta minimo entre lecturas consecutivas.
JUMP_TEMP=0.5
JUMP_HUM=5

# ===== Telegram (alertas + entrega de reportes PDF) =====
# Si TELEGRAM_ENABLED=true y hay token + chat_id, se mandan alertas al entrar/salir
# de rango y los reportes programados. El bot_token SOLO se configura aqui (.env),
# nunca por API. Sin estas variables el sistema funciona igual, sin Telegram.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_SEC=300

# ===== Reportes PDF + scheduler =====
# REPORTS_ENABLED expone /api/reports* y las tools de reporte del agente.
# puppeteer descarga Chromium por default; en Raspberry Pi conviene usar el del
# sistema apuntando PUPPETEER_EXECUTABLE_PATH (ej. /usr/bin/chromium-browser).
REPORTS_ENABLED=true
REPORTS_DIR=reports
SCHEDULES_PATH=reports/schedules.json
PUPPETEER_EXECUTABLE_PATH=
